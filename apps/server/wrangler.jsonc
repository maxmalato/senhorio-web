{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senhorio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Sem telemetria do Wrangler (privacidade)
  "send_metrics": false,
  // Endereço público gratuito: senhorio.<subdomínio da conta>.workers.dev (docs/07, "Publicação")
  "workers_dev": true,
  // Sem endereços de prévia por versão: só um endereço público
  "preview_urls": false,
  // Sem registros de acesso guardados na Cloudflare (docs/07, "Segurança e privacidade")
  "observability": { "enabled": false },
  // O Worker serve o site (apps/web/dist) e responde primeiro só nas rotas /api/*
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Uma instância de Room por sala (modo de vários dispositivos, Etapa 4)
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  // Durable Objects com SQLite: os únicos disponíveis no plano gratuito
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
}
